TG_BOT_API_ID=<telegram-api-id>
TG_BOT_API_HASH=<telegram-api-hash>
TG_BOT_DATA_DIR=./data
# 数据库类型：sqlite 或 postgresql
TG_BOT_DATABASE=sqlite
# 选择 postgresql 时必须填写完整连接串；也可直接用 TG_BOT_DATABASE_URL 覆盖类型默认值
# TG_BOT_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>
TG_BOT_ADMIN_CHAT_IDS=
# BotFather 创建的机器人 Token；未配置时通知功能保持禁用
TG_BOT_NOTIFICATION_BOT_TOKEN=
TG_BOT_LOG_LEVEL=INFO
TG_BOT_LOG_FILE=tg-bot.log
TG_BOT_LOG_MAX_BYTES=10485760
TG_BOT_LOG_BACKUP_COUNT=5
# 使用 `openssl rand -base64 48` 生成，不得使用示例文本作为实际密钥
TG_BOT_ADMIN_KEY=<openssl-rand-base64-48>
TG_BOT_ADMIN_ORIGIN=https://<admin-host>
TG_BOT_ADMIN_SESSION_DAYS=30
TG_BOT_API_HOST=0.0.0.0
TG_BOT_API_PORT=8000
TG_BOT_TRANSPORT_KEY_ROTATION_HOURS=24
# 仅在管理 API 前有反向代理时显式填写 CIDR，逗号分隔
TG_BOT_TRUSTED_PROXIES=
